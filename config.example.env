# Copy to config.env (git-ignored) and edit. Plain KEY=VALUE lines only: the file is
# parsed, never executed, and inline comments are not supported.

# An SSH alias you define yourself in ~/.ssh/config (Host entry with HostName, User,
# IdentityFile). One alias, key or agent authentication only; no passwords are used.
HPC_HOST=my-cluster

# Directory on the cluster that receives the package. Absolute, or relative to your
# home directory there. Use one directory per package. Allowed characters:
# letters, digits and . _ / + -
REMOTE_DIR=runs/my-run

# The job script inside the package directory, relative to its top level.
JOB_SCRIPT=job.sbatch

# How many times resubmit.sh may resubmit after a FAILED/TIMEOUT/NODE_FAIL job
# (hard cap 10). 0 disables resubmission.
MAX_RESUBMITS=2

# Seconds between checks in `poll.sh --watch` (minimum 60, to be gentle on the scheduler).
POLL_INTERVAL=300

# `poll.sh --watch` stops after this many hours (0 = check once and stop).
MAX_POLL_HOURS=24
