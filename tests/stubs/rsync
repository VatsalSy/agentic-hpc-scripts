#!/usr/bin/env bash
# Fake rsync: copies SRC/ into the path after "host:" in DEST, and logs the call.
set -u
src=""
dst=""
while [ $# -gt 0 ]; do
  case $1 in
    -e) shift 2 ;;
    -*) shift ;;
    *) if [ -z "$src" ]; then src=$1; else dst=$1; fi; shift ;;
  esac
done
echo "rsync $src -> $dst" >> "$FAKE_ROOT/calls.log"
[ ! -e "$FAKE_ROOT/rsync_fail" ] || { echo "rsync: failed (stub)" >&2; exit 12; }
dst=${dst#*:}
mkdir -p "$dst"
cp -R "$src". "$dst"
